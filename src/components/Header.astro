---
import Logo from './Logo.astro'
import Nav from './Nav.astro'
---

<script is:inline>
  window.__kinoHeaderScrollCleanup?.()

  const syncHeaderScroll = () => {
    document
      .querySelector('header')
      ?.classList.toggle('scrolled', window.scrollY > 50)
  }

  window.addEventListener('scroll', syncHeaderScroll, { passive: true })
  document.addEventListener('astro:page-load', syncHeaderScroll)
  document.addEventListener('astro:before-swap', syncHeaderScroll)

  window.__kinoHeaderScrollCleanup = () => {
    window.removeEventListener('scroll', syncHeaderScroll)
    document.removeEventListener('astro:page-load', syncHeaderScroll)
    document.removeEventListener('astro:before-swap', syncHeaderScroll)
  }

  syncHeaderScroll()
</script>

<div class='header-placeholder'></div>
<header>
  <div class='logo'>
    <Logo />
  </div>
  <Nav />
</header>

<style>
  .header-placeholder {
    height: calc(4em + 75px);
  }

  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    margin: 0 auto;
    max-width: 1400px;
    padding: 2em;
    width: 100%;
    transition: all 0.3s ease;
    z-index: 99;
  }

  header.scrolled {
    padding: 0;
    background: var(--bg-color);
    max-width: 100%;
    padding: 0 10%;
  }

  :global(.theme-dark) header {
    color: var(--p5-white);
  }

  :global(.theme-dark) header.scrolled {
    background: var(--p5-black);
    border-bottom: 4px solid var(--primary);
    box-shadow: 0 0.35rem 0 var(--p5-white);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 0.45rem), 92% 100%, 0 100%);
  }

  @media screen and (max-width: 520px) {
    .header-placeholder {
      height: calc(4em + 75px);
    }

    header {
      padding: 2em 0;
    }

    header.scrolled {
      padding: 0;
    }
  }
</style>
