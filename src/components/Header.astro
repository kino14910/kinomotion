---
import Logo from './Logo.astro'
import Nav from './Nav.astro'
---
<div class='header-placeholder'></div>

<header>
  <div class='logo'>
    <Logo />
  </div>

  <Nav />
</header>

<script is:inline>
  window.__kinoHeaderScrollCleanup?.()

  let ticking = false
  let lastScrolled = false

  const updateHeaderState = () => {
    ticking = false

    const scrolled = window.scrollY > 50

    if (scrolled === lastScrolled) {
      return
    }

    lastScrolled = scrolled

    document.documentElement.toggleAttribute('data-scrolled', scrolled)
  }

  const onScroll = () => {
    if (ticking) {
      return
    }

    ticking = true

    requestAnimationFrame(updateHeaderState)
  }

  const init = () => {
    updateHeaderState()
  }

  window.addEventListener('scroll', onScroll, {
    passive: true,
  })

  document.addEventListener('astro:page-load', init)
  document.addEventListener('astro:before-swap', init)

  window.__kinoHeaderScrollCleanup = () => {
    window.removeEventListener('scroll', onScroll)
    document.removeEventListener('astro:page-load', init)
    document.removeEventListener('astro:before-swap', init)
  }

  init()
</script>

<style>
  .header-placeholder {
    height: calc(4em + 75px);
  }

  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    margin: 0 auto;
    width: 100%;
    max-width: 1400px;
    padding: 2em;
    z-index: 99;
    container-type: inline-size;
    container-name: header;
    will-change: padding, background, clip-path;
    backface-visibility: hidden;
    transition:
      padding 0.3s ease,
      max-width 0.3s ease,
      background-color 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease,
      clip-path 0.3s ease;
  }

  :global(html[data-scrolled]) header {
    max-width: 100%;
    padding: 0 10%;
    background: var(--bg-color);
    border-bottom: 4px solid var(--primary);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 0.45rem), 92% 100%, 0 100%);
  }

  :global(.theme-dark) header {
    color: var(--p5-white);
  }

  :global(.theme-dark) html[data-scrolled] header {
    background: var(--p5-black);

    box-shadow: 0 0.35rem 0 var(--p5-white);
  }

  @container header (width <= 520px) {
    .header-placeholder {
      height: calc(4em + 75px);
    }

    header {
      padding: 2em 0;
    }

    :global(html[data-scrolled]) header {
      padding: 0;
    }
  }
</style>
