---
import Layout from '@/layouts/Layout.astro'
import BlogLink from './BlogLink.svelte'

export interface Props {
  title: string
  description: string
  posts: Array<{
    id: string
    data: {
      title: string
      pubDate: Date
    }
  }>
  basePath: string
  showDate?: boolean
}

const {
  title,
  description,
  posts,
  basePath,
  showDate = true,
} = Astro.props
---

<Layout title={title} description={description}>
  <main>
    <header class="page-head">
      <h1 class="page-title" data-text={title}>{title}</h1>
      <p class="page-count">{posts.length} Entries</p>
    </header>
    <section>
      <ul>
        {
          posts.map((post, i) => (
            <li style={`--tilt: ${i % 2 === 0 ? '-0.8deg' : '0.8deg'}`}>
              <BlogLink
                url={`/${basePath}/${post.id}/`}
                title={post.data.title}
                showDate={showDate}
                pubDate={post.data.pubDate}
                index={i}
              />
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Layout>

<style>
  :global(.layout) {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    height: min-content;
    position: relative;
  }

  main {
    flex: 1;
    margin: 0 auto;
    max-width: 1400px;
    padding: 1em 2em 4em;
    box-sizing: border-box;
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .page-head {
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: 1.5rem;
    margin: 0 0 2.5rem;
    flex-wrap: wrap;
  }

  .page-title {
    position: relative;
    margin: 0;
    font-family: var(--font-family-display);
    font-size: clamp(3.5rem, 9vw, 8rem);
    font-weight: 400;
    line-height: 0.85;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    transform: skewX(-8deg) rotate(-1.5deg);
    color: var(--p5-ink);
    text-shadow:
      0.05em 0.05em 0 var(--p5-red),
      0.09em 0.09em 0 var(--p5-paper);
  }

  .page-title::after {
    content: '';
    position: absolute;
    left: 2%;
    right: -4%;
    bottom: -0.18em;
    height: 0.14em;
    background: repeating-linear-gradient(
      -45deg,
      var(--p5-red) 0 12px,
      var(--p5-ink) 12px 24px
    );
    transform: skewX(-24deg);
  }

  :global(.theme-dark) .page-title {
    color: var(--p5-white);
    -webkit-text-stroke: 0.02em var(--p5-black);
    text-shadow:
      0.05em 0.05em 0 var(--p5-red),
      0.09em 0.09em 0 var(--p5-white);
  }

  :global(.theme-dark) .page-title::after {
    background: repeating-linear-gradient(
      -45deg,
      var(--p5-white) 0 12px,
      var(--p5-red) 12px 24px
    );
  }

  .page-count {
    margin: 0 0 0.4em;
    padding: 0.3em 0.8em;
    font-family: var(--font-family-sans-code);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dd-ink);
    background: var(--dd-cyan);
    border: 2px solid var(--dd-ink);
    transform: skewX(-10deg);
    box-shadow: 0.25rem 0.25rem 0 var(--dd-pink);
  }

  :global(.theme-dark) .page-count {
    color: var(--p5-black);
    background: var(--p5-white);
  }

  ul {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.4rem;
    list-style-type: none;
    margin: 0;
    padding: 0;
  }

  ul li {
    width: 100%;
    margin: 0;
  }

  ul li:nth-child(4n + 2) {
    transform: translateY(0.9rem);
  }

  ul li:nth-child(4n + 3) {
    transform: translateY(0.35rem);
  }

  @media (max-width: 1100px) {
    ul {
      grid-template-columns: repeat(2, 1fr);
    }

    ul li:nth-child(n) {
      transform: none;
    }
  }

  @media (max-width: 640px) {
    ul {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
