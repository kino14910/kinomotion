---
const { href } = Astro.props
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '')
const subpath = pathname.match(/[^\/]+/g)
const isActive = href === pathname || href === '/' + (subpath?.[0] || '')
---

<a class={`${isActive ? 'selected' : ''}`} href=`/${href}`>{href || 'home'}</a>
<style>
  a {
    color: inherit;
    text-decoration: none;
    padding: 8px 18px;
    display: block;
    position: relative;
    margin-left: 12px;
    min-width: 60px;
    text-align: center;
    user-select: none;
    font-weight: 700;
    letter-spacing: 0.04em;
    border: 2px solid var(--p5-ink);
    transform: skewX(-8deg);
    background: transparent;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      background-color 0.18s ease,
      color 0.18s ease;
    box-sizing: border-box;

    &:not(.selected) {
      opacity: 0.75;
    }

    &:hover {
      opacity: 1;
      background: var(--dd-cyan);
      color: var(--dd-ink);
      box-shadow: 0.28rem 0.28rem 0 var(--dd-pink);
      transform: translate(-0.08rem, -0.08rem) skewX(-8deg);
    }

    &::before {
      content: '';
      position: absolute;
      left: 12px;
      right: 12px;
      bottom: 4px;
      height: 4px;
      background: var(--dd-pink);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    }

    &.selected {
      opacity: 1;
      background: var(--dd-pink);
      color: var(--p5-white);
      box-shadow: 0.28rem 0.28rem 0 var(--dd-ink);
    }

    &.selected::before {
      transform: scaleX(1);
      background: var(--p5-white);
    }
  }

  :global(.theme-dark) a {
    color: var(--p5-white);
    border-color: var(--p5-white);
    box-shadow: 0.2rem 0.2rem 0 var(--p5-red);
  }

  :global(.theme-dark) a:not(.selected) {
    opacity: 0.85;
  }

  :global(.theme-dark) a:hover {
    background: var(--p5-red);
    color: var(--p5-white);
    box-shadow: 0.32rem 0.32rem 0 var(--p5-white);
  }

  :global(.theme-dark) a:hover::before {
    background: var(--p5-white);
  }

  :global(.theme-dark) a.selected {
    background: var(--p5-red);
    color: var(--p5-white);
    box-shadow: 0.32rem 0.32rem 0 var(--p5-white);
  }

  :global(.theme-dark) a.selected::before {
    background: var(--p5-white);
  }
</style>
