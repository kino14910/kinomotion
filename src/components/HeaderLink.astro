---
const { href, ...props } = Astro.props
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '')
const subpath = pathname.match(/[^\/]+/g)
const isActive = href === pathname || href === '/' + (subpath?.[0] || '')
---

<a class={`${isActive ? 'selected' : ''}`} href=`/${href}`>{href || 'home'}</a>
<style>
  a {
    color: inherit;
    text-decoration: none;
    padding: 10px 5px;
    display: block;
    position: relative;
    margin-left: 20px;
    min-width: 70px;
    text-align: center;
    user-select: none;
    font-weight: 600;

    &:not(.selected) {
      opacity: 0.7;
    }
    &::before {
      content: '';
      position: absolute;
      transition: transform 0.3s ease;
      left: 0;
      bottom: 0;
      width: 100%;
      height: 2px;
      background: var(--text-secondary);
      transform: scaleX(0);
    }

    &:hover::before,
    .selected::before {
      transform: scaleX(1);
    }
  }

  :global(.theme-dark) a {
    color: var(--p5-white);
    letter-spacing: 0.04em;
    opacity: 1;
    transform: skewX(-8deg);
  }

  :global(.theme-dark) a:not(.selected) {
    opacity: 0.82;
  }

  :global(.theme-dark) a::before {
    height: 4px;
    background: var(--primary);
    box-shadow: 0 -0.25rem 0 var(--p5-white);
    transform-origin: left;
  }

  :global(.theme-dark) a:hover,
  :global(.theme-dark) a.selected {
    color: var(--p5-white);
  }

  :global(.theme-dark) a:hover::before,
  :global(.theme-dark) a.selected::before {
    transform: scaleX(1);
  }
</style>
