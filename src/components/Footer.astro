---
const today = new Date()
---

<footer>
  <div class="footer-edge" aria-hidden="true"></div>
  <div class="footer-band" aria-hidden="true"></div>

  <div class="footer-content">
    <p class="made-with">
      <span class="typed-text">Made with</span>
      <span class="heart">♥</span>
      <span class="typed-text">&amp; caffeine</span>
    </p>

    <p class="copyright">&copy; {today.getFullYear()} Kino. All rights reserved.</p>

    <div class="footer-links">
      <a
        href="https://github.com/kino14910"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="github link"
      >
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
          <path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
          />
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  footer {
    position: relative;
    background: var(--footer-bg);
    color: var(--footer-fg);
  }

  :global(.theme-dark) footer {
    --footer-bg: var(--p5-black);
    --footer-fg: var(--p5-white);
    --footer-edge: var(--p5-red);
  }

  footer {
    --footer-bg: var(--p5-ink);
    --footer-fg: var(--p5-paper);
    --footer-edge: var(--p5-red);
  }

  .footer-edge {
    height: 18px;
    background:
      conic-gradient(from 135deg at 50% 100%, var(--footer-edge) 90deg, transparent 0)
      0 0 / 36px 100% repeat-x;
  }

  .footer-band {
    height: 10px;
    background: repeating-linear-gradient(
      -45deg,
      var(--p5-red) 0 14px,
      var(--footer-bg) 14px 28px,
      var(--footer-fg) 28px 34px,
      var(--footer-bg) 34px 52px
    );
    opacity: 0.9;
  }

  .footer-content {
    padding: 2.2rem 1.5rem 2.8rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
  }

  .made-with {
    font-family: var(--font-family-sans-code);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0;
    overflow: hidden;
    white-space: nowrap;
    width: 0;
    animation: typing 2s steps(22, end) 0.5s forwards;
  }

  @keyframes typing {
    from {
      width: 0;
    }
    to {
      width: 15.5em;
    }
  }

  .heart {
    display: inline-block;
    color: var(--p5-red);
    animation: heart-beat 1.4s ease-in-out infinite;
  }

  @keyframes heart-beat {
    0%,
    100% {
      transform: scale(1);
    }
    30% {
      transform: scale(1.25);
    }
  }

  .copyright {
    font-size: 0.75rem;
    margin: 0;
    opacity: 0.65;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .footer-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--footer-fg);
    border: 2px solid var(--footer-fg);
    transform: skewX(-8deg);
    box-shadow: 0.22rem 0.22rem 0 var(--p5-red);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      background-color 0.18s ease,
      color 0.18s ease;
  }

  .footer-links a svg {
    transform: skewX(8deg);
  }

  .footer-links a:hover {
    background: var(--p5-red);
    color: var(--p5-white);
    box-shadow: 0.32rem 0.32rem 0 var(--footer-fg);
    transform: translate(-0.06rem, -0.06rem) skewX(-8deg);
  }
</style>
