---
import { Image } from 'astro:assets'
import logo from '../assets/logo.webp'
---

<style>
  a {
    display: block;
    line-height: 0;
  }

  @media screen and (max-width: 520px) {
    a {
      display: none;
    }
  }
</style>

<a href='/'>
  <Image
    alt='Logo'
    src={logo}
    width={75}
    height={75}
    loading='eager'
    densities={[1, 2]}
  />
</a>
