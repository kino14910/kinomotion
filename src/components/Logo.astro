---
import { Image } from 'astro:assets'
import logo from '../assets/logo.webp'
---

<style>
  a {
    display: block;
    line-height: 0;
    transition:
      transform 0.2s ease,
      filter 0.2s ease;
  }

  a:hover {
    transform: rotate(-4deg) scale(1.06);
    filter: drop-shadow(0.18rem 0.18rem 0 var(--p5-red));
  }

  :global(.theme-dark) a {
    filter: drop-shadow(0.12rem 0.12rem 0 var(--p5-red));
  }

  :global(.theme-dark) a:hover {
    filter: drop-shadow(0.22rem 0.22rem 0 var(--p5-white));
  }

  @media screen and (max-width: 520px) {
    a {
      display: none;
    }
  }
</style>

<a href='/'>
  <Image
    alt='Logo'
    src={logo}
    width={75}
    height={75}
    loading='eager'
    densities={[1, 2]}
  />
</a>
