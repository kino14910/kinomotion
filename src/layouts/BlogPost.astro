---
import BackToTop from '@/components/BackToTop.svelte'
import FormattedDate from '@/components/FormattedDate.svelte'
import { SITE_TITLE } from '@/consts'
import { Image } from 'astro:assets'
import type { MarkdownHeading } from 'astro'
import Layout from './Layout.astro'

interface Props {
  title: string
  description?: string
  pubDate: Date
  updatedDate?: Date
  heroImage?: ImageMetadata
  tags?: string[]
  headings?: MarkdownHeading[]
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags,
  headings,
} = Astro.props

const filteredHeadings = headings?.filter(h => h.depth >= 2 && h.depth <= 3) || []

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString()
const imageURL = heroImage ? new URL(heroImage.src, Astro.site).toString() : ''
const siteURL = Astro.site?.toString() ?? ''
const logoURL = new URL('/favicon.ico', Astro.site).toString()

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description ?? title,
  "image": imageURL ? [imageURL] : [],
  "datePublished": pubDate.toISOString(),
  "dateModified": updatedDate ? updatedDate.toISOString() : pubDate.toISOString(),
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL
  },
  "inLanguage": "zh-CN",
  "keywords": tags?.join(', '),
  "author": {
    "@type": "Organization",
    "name": SITE_TITLE,
    "url": siteURL
  },
  "publisher": {
    "@type": "Organization",
    "name": SITE_TITLE,
    "url": siteURL,
    "logo": {
      "@type": "ImageObject",
      "url": logoURL
    }
  }
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteURL
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Note",
      "item": new URL('/note/', Astro.site).toString()
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": title,
      "item": canonicalURL
    }
  ]
}
---

<Layout
  title={title}
  description={description}
  image={heroImage}
  type='article'
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  tags={tags}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <main>
    {
      filteredHeadings.length > 0 && (
        <aside class='contents'>
          <h2>目录</h2>
          <nav class='toc' id='toc'>
            <ul>
              {filteredHeadings.map(heading => (
                <li
                  style={`margin-left: ${(heading.depth - 2) * 0.5}em`}
                  data-depth={heading.depth}
                >
                  <a href={`#${heading.slug}`} data-slug={heading.slug}>
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
    <article>
      <div class='prose'>
        <div class='title'>
          <div class='date'>
            <FormattedDate date={pubDate} />
            {
              updatedDate && (
                <div class='last-updated-on'>
                  Last updated on <FormattedDate date={updatedDate} />
                </div>
              )
            }
          </div>
          <h1 data-text={title}>{title}</h1>
          {tags && tags.length > 0 && (
            <ul class='tags'>
              {tags.map(tag => <li class='tag'>#{tag}</li>)}
            </ul>
          )}
          <hr />
        </div>
        {heroImage && (
          <Image src={heroImage} alt={title} class='hero-image' />
        )}
        <slot />
      </div>
    </article>
  </main>
  <BackToTop client:load />
</Layout>

<script>
  import { scrollTo } from '@/lib/lenis'

  let scrollHandler: ((e: Event) => void) | null
  let resizeHandler: ((e: Event) => void) | null
  let observer: IntersectionObserver | null = null
  let activeUpdateFrame: number | null = null
  let lastPageScrollTop = 0
  let lastTocTargetTop = -1
  let tocNavigationTimeout: number | null = null
  let isTocNavigating = false
  let clickHandlers: {
    el: HTMLAnchorElement
    handler: (e: MouseEvent) => void
  }[] = []
  const scrollOffset = 80
  const tocScrollJitterThreshold = 4
  const tocScrollPadding = 12
  const visibleViewportBottomRatio = 0.92
  const pageEdgeThreshold = 12
  const globalWindow = window as Window & {
    __kinoBlogPostCleanup?: () => void
  }

  function getLinkTargetId(link: HTMLAnchorElement) {
    const rawId = link.getAttribute('href')?.slice(1) ?? ''

    try {
      return decodeURIComponent(rawId)
    } catch {
      return rawId
    }
  }

  type PageScrollState = 'top' | 'middle' | 'bottom'

  function getPageScrollState(): PageScrollState {
    const scrollTop = window.scrollY || document.documentElement.scrollTop
    const maxScrollTop = Math.max(
      0,
      document.documentElement.scrollHeight - window.innerHeight,
    )

    if (scrollTop <= pageEdgeThreshold) {
      return 'top'
    }

    if (maxScrollTop - scrollTop <= pageEdgeThreshold) {
      return 'bottom'
    }

    return 'middle'
  }

  function getActiveHeadingIds(headings: HTMLElement[]) {
    const pageScrollState = getPageScrollState()
    const viewportTop = scrollOffset
    const viewportBottom = window.innerHeight * visibleViewportBottomRatio
    const activeIds = new Set<string>()

    if (headings.length === 0) {
      return activeIds
    }

    if (pageScrollState === 'top') {
      activeIds.add(headings[0].id)
    } else if (pageScrollState === 'bottom') {
      activeIds.add(headings[headings.length - 1].id)
    }

    headings.forEach((heading, index) => {
      const nextHeading = headings[index + 1]
      const top = heading.getBoundingClientRect().top
      const bottom =
        nextHeading?.getBoundingClientRect().top ?? document.body.getBoundingClientRect().bottom
      const isActive = top < viewportBottom && bottom > viewportTop

      if (isActive) {
        activeIds.add(heading.id)
      }
    })

    if (activeIds.size === 0 && headings.length > 0) {
      let closestHeading = headings[0]
      let minDistance = Number.POSITIVE_INFINITY

      headings.forEach(heading => {
        const distance = Math.abs(heading.getBoundingClientRect().top - viewportTop)

        if (distance < minDistance) {
          minDistance = distance
          closestHeading = heading
        }
      })

      activeIds.add(closestHeading.id)
    }

    return activeIds
  }

  function getMaxTocScrollTop(toc: HTMLElement) {
    return Math.max(0, toc.scrollHeight - toc.clientHeight)
  }

  function scrollTocTo(toc: HTMLElement, targetTop: number, immediate = false) {
    const maxTop = getMaxTocScrollTop(toc)
    const top = Math.max(0, Math.min(targetTop, maxTop))

    if (
      Math.abs(toc.scrollTop - top) < tocScrollJitterThreshold
      && Math.abs(lastTocTargetTop - top) < tocScrollJitterThreshold
    ) {
      return
    }

    lastTocTargetTop = top
    toc.scrollTo({
      top,
      left: 0,
      behavior: immediate ? 'auto' : 'smooth',
    })
  }

  function getActiveRangeTargetTop(
    toc: HTMLElement,
    activeLinks: HTMLElement[],
  ) {
    const tocRect = toc.getBoundingClientRect()
    const topmost = activeLinks[0]
    const bottommost = activeLinks[activeLinks.length - 1]
    const topRect = topmost.getBoundingClientRect()
    const bottomRect = bottommost.getBoundingClientRect()
    const activeRangeHeight = bottomRect.bottom - topRect.top
    const activeRangeFullyVisible =
      topRect.top >= tocRect.top && bottomRect.bottom <= tocRect.bottom

    if (activeRangeFullyVisible) {
      return null
    }

    if (activeRangeHeight <= toc.clientHeight) {
      if (topRect.top < tocRect.top) {
        return topmost.offsetTop - tocScrollPadding
      }

      return (
        bottommost.offsetTop
        + bottommost.offsetHeight
        + tocScrollPadding
        - toc.clientHeight
      )
    }

    const rangeTop = topmost.offsetTop
    const rangeBottom = bottommost.offsetTop + bottommost.offsetHeight
    const currentScrollTop = window.scrollY || document.documentElement.scrollTop
    const isScrollingDown = currentScrollTop >= lastPageScrollTop

    if (isScrollingDown) {
      return rangeBottom + tocScrollPadding - toc.clientHeight
    }

    return rangeTop - tocScrollPadding
  }

  function scrollActiveLinksIntoView(
    toc: HTMLElement,
    activeLinks: HTMLElement[],
    immediate = false,
  ) {
    const pageScrollState = getPageScrollState()

    if (pageScrollState === 'top') {
      scrollTocTo(toc, 0, true)
      return
    }

    if (pageScrollState === 'bottom') {
      scrollTocTo(toc, getMaxTocScrollTop(toc), true)
      return
    }

    if (activeLinks.length === 0) {
      return
    }

    const targetTop = getActiveRangeTargetTop(toc, activeLinks)

    if (targetTop !== null) {
      scrollTocTo(toc, targetTop, immediate)
    }
  }

  function updateTocActiveState(
    toc: HTMLElement,
    links: HTMLAnchorElement[],
    headings: HTMLElement[],
  ) {
    const activeHeadingIds = getActiveHeadingIds(headings)
    const activeLinks: HTMLAnchorElement[] = []

    links.forEach(link => {
      const isActive = Boolean(link.dataset.slug && activeHeadingIds.has(link.dataset.slug))
      link.classList.toggle('active', isActive)

      if (isActive) {
        activeLinks.push(link)
      }
    })

    if (!isTocNavigating) {
      scrollActiveLinksIntoView(toc, activeLinks)
    }

    lastPageScrollTop = window.scrollY || document.documentElement.scrollTop
  }

  function scheduleTocActiveUpdate(
    toc: HTMLElement,
    links: HTMLAnchorElement[],
    headings: HTMLElement[],
  ) {
    if (activeUpdateFrame) {
      return
    }

    activeUpdateFrame = window.requestAnimationFrame(() => {
      activeUpdateFrame = null
      updateTocActiveState(toc, links, headings)
    })
  }

  function setupBlogPost() {
    cleanupBlogPost()

    const toc = document.getElementById('toc')
    const body = document.body
    const links = toc
      ? Array.from(toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'))
      : []
    const headings = Array.from(
      document.querySelectorAll<HTMLElement>(
        '.prose h1[id], .prose h2[id], .prose h3[id]',
      ),
    )

    scrollHandler = (_: Event) => {
      if (window.scrollY > 50) {
        body.classList.add('scrolled')
      } else {
        body.classList.remove('scrolled')
      }

      if (toc && links.length > 0 && headings.length > 0) {
        scheduleTocActiveUpdate(toc, links, headings)
      }
    }

    window.addEventListener('scroll', scrollHandler, { passive: true })
    scrollHandler(new Event('scroll'))

    if (toc && links.length > 0 && headings.length > 0) {
      resizeHandler = (_: Event) => {
        lastTocTargetTop = -1
        scheduleTocActiveUpdate(toc, links, headings)
      }
      window.addEventListener('resize', resizeHandler, { passive: true })

      observer = new IntersectionObserver(
        () => {
          scheduleTocActiveUpdate(toc, links, headings)
        },
        {
          rootMargin: `-${scrollOffset}px 0px -60% 0px`,
          threshold: [0, 1],
        },
      )

      headings.forEach(heading => {
        observer?.observe(heading)
      })

      links.forEach(link => {
        const handler = (e: MouseEvent) => {
          e.preventDefault()
          const targetId = getLinkTargetId(link)
          const targetElement = document.getElementById(targetId)

          if (targetElement) {
            isTocNavigating = true
            links.forEach(item => {
              item.classList.toggle('active', item === link)
            })
            scrollActiveLinksIntoView(toc, [link], true)

            const elementPosition = targetElement.getBoundingClientRect().top
            const offsetPosition =
              elementPosition + window.pageYOffset - scrollOffset

            scrollTo(offsetPosition)

            if (tocNavigationTimeout) {
              window.clearTimeout(tocNavigationTimeout)
            }
            tocNavigationTimeout = window.setTimeout(() => {
              isTocNavigating = false
              scheduleTocActiveUpdate(toc, links, headings)
            }, 700)
          }
        }
        link.addEventListener('click', handler)
        clickHandlers.push({ el: link, handler })
      })

      updateTocActiveState(toc, links, headings)
    }
  }

  function cleanupBlogPost() {
    if (scrollHandler) {
      window.removeEventListener('scroll', scrollHandler)
      scrollHandler = null
    }
    if (resizeHandler) {
      window.removeEventListener('resize', resizeHandler)
      resizeHandler = null
    }
    if (observer) {
      observer.disconnect()
      observer = null
    }
    if (activeUpdateFrame) {
      window.cancelAnimationFrame(activeUpdateFrame)
      activeUpdateFrame = null
    }
    lastPageScrollTop = 0
    lastTocTargetTop = -1
    if (tocNavigationTimeout) {
      window.clearTimeout(tocNavigationTimeout)
      tocNavigationTimeout = null
    }
    isTocNavigating = false
    clickHandlers.forEach(({ el, handler }) => {
      el.removeEventListener('click', handler)
    })
    clickHandlers = []
    document.body.classList.remove('scrolled')
  }

  globalWindow.__kinoBlogPostCleanup?.()

  document.addEventListener('astro:page-load', setupBlogPost)
  document.addEventListener('astro:before-swap', cleanupBlogPost)

  globalWindow.__kinoBlogPostCleanup = () => {
    cleanupBlogPost()
    document.removeEventListener('astro:page-load', setupBlogPost)
    document.removeEventListener('astro:before-swap', cleanupBlogPost)
  }
</script>

<style>
  main {
    max-width: calc(100% - 2em);
    margin: 0;
    flex: 1;
    display: flex;
    justify-content: center;
    gap: 2em;
  }

  .prose {
    width: 100dvw;
    max-width: 720px;
    margin: auto;
    padding: 1em;
    color: var(--text-main);
  }

  .title {
    margin-bottom: 1em;
    padding: 1em 0;
    text-align: left;
    line-height: 1;
  }

  .title h1 {
    position: relative;
    display: block;
    margin: 0;
    font-family: var(--font-family-display);
    font-weight: 800;
    letter-spacing: 0.02em;
    line-height: 1.15;
    color: var(--p5-ink);
    text-shadow:
      0.05em 0.05em 0 var(--p5-red),
      0.09em 0.09em 0 var(--p5-paper);
  }

  :global(.theme-dark) .title h1 {
    color: var(--p5-white);
    text-shadow:
      0.07em 0.07em 0 var(--p5-red),
      -0.03em -0.02em 0 var(--p5-black);
  }

  .date {
    display: inline-block;
    margin-bottom: 0.9em;
    padding: 0.25em 0.7em;
    font-family: var(--font-family-sans-code);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--p5-white);
    background: var(--p5-red);
    transform: skewX(-10deg);
    box-shadow: 0.25rem 0.25rem 0 var(--p5-ink);
  }

  :global(.theme-dark) .date {
    box-shadow: 0.25rem 0.25rem 0 var(--p5-white);
  }

  .last-updated-on {
    display: inline-block;
    margin-left: 0.6em;
    font-style: normal;
    font-size: 0.75rem;
    color: var(--p5-paper);
    opacity: 0.85;
  }

  :global(.theme-dark) .last-updated-on {
    color: var(--p5-white);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em;
    margin: 0.9em 0 0;
    padding: 0;
    list-style: none;
    -webkit-padding-start: 0;
  }

  .tag {
    margin: 0;
    padding: 0.25em 0.7em;
    font-family: var(--font-family-sans-code);
    font-size: 0.8em;
    font-weight: 700;
    color: var(--p5-ink);
    background: var(--p5-white);
    border: 2px solid var(--p5-ink);
    transform: skewX(-10deg);
    box-shadow: 0.2rem 0.2rem 0 var(--p5-red);
  }

  :global(.theme-dark) .tag {
    color: var(--p5-black);
    background: var(--p5-white);
    border-color: var(--p5-white);
    box-shadow: 0.2rem 0.2rem 0 var(--p5-red);
  }

  .hero-image {
    width: 100%;
    height: auto;
    margin: 0 0 1.5em;
    border: 3px solid var(--p5-ink);
    clip-path: var(--cut-notch);
    box-shadow: 0.4rem 0.4rem 0 var(--p5-red);
  }

  :global(.theme-dark) .hero-image {
    border-color: var(--p5-white);
  }

  aside {
    position: sticky;
    top: 2em;
    width: 240px;
    max-width: 25dvw;
    height: fit-content;
    max-height: calc(100dvh - 75px - 4em);
    padding: 1.5em;
    background: var(--p5-white);
    border: 3px solid var(--p5-ink);
    clip-path: var(--cut-notch);
    box-shadow: 0.4rem 0.4rem 0 var(--p5-red);
    transition:
      top 0.3s ease,
      max-height 0.3s ease;
  }

  :global(.theme-dark) aside {
    background: var(--p5-black);
    border-color: var(--p5-white);
    box-shadow: 0.4rem 0.4rem 0 var(--p5-red);
  }

  aside h2 {
    margin: 0 0 1em 0;
    padding-bottom: 0.5em;
    font-family: var(--font-family-display);
    font-size: 1.5em;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--p5-ink);
    border-bottom: 4px solid var(--p5-red);
    transform: skewX(-6deg);
  }

  :global(.theme-dark) aside h2 {
    color: var(--p5-white);
    text-shadow: 0.08em 0.08em 0 var(--p5-red);
  }

  .toc {
    max-height: calc(100dvh - 75px - 8em);
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }

  :global(body.scrolled) .contents {
    top: 5em;
    max-height: calc(100dvh - 80px - 2em);
  }

  :global(body.scrolled) .toc {
    max-height: calc(100dvh - 80px - 6em);
  }

  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc li {
    margin: 0;
  }

  .toc a {
    display: block;
    padding: 0.25em 0.5em;
    color: var(--p5-ink);
    text-decoration: none;
    font-weight: 600;
    border-left: 5px solid transparent;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease,
      transform 0.15s ease;
  }

  .toc a:hover {
    background: var(--p5-red);
    color: var(--p5-white);
    transform: skewX(-6deg);
  }

  .toc a.active {
    background: var(--p5-ink);
    color: var(--p5-paper);
    border-left-color: var(--p5-red);
    font-weight: 800;
  }

  :global(.theme-dark) .toc a {
    color: var(--p5-white);
  }

  :global(.theme-dark) .toc a:hover {
    background: var(--p5-red);
    color: var(--p5-white);
  }

  :global(.theme-dark) .toc a.active {
    background: var(--p5-white);
    color: var(--p5-black);
    border-left-color: var(--p5-red);
  }

  @media (max-width: 1024px) {
    .contents,
    .toc {
      display: none;
    }

    main {
      max-width: 100dvw;
    }
  }

  .layout {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    position: relative;
  }
</style>
